DATABASE_URL=
SECRET_KEY=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=NED Transport Hub

ALLOWED_EMAIL_DOMAINS=cloud.neduet.edu.pk
CORS_ORIGINS=*                # Use '*' for local mobile dev, or comma-separated origins in production

FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=
FIRST_ADMIN_NAME=System Admin

PAYMENT_WEBHOOK_SECRET=


GOOGLE_MAPS_API_KEY=          # Directions/Geocoding API key. Empty = straight-line fallback
CORRIDOR_RADIUS_M=500
MATCH_TIME_WINDOW_MINUTES=60
FARE_RATE_PER_KM=35
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=       # required to accept payment webhooks (min 16 chars recommended)
FCM_CREDENTIALS_FILE=         # path to Firebase service-account JSON; empty = push logged only
                              # Firebase console > Project settings > Service accounts > Generate new private key
                              # Keep this file OUT of git.
SMS_PROVIDER=console
REMINDERS_ENABLED=true
REMINDER_MINUTES_BEFORE=30
PUBLIC_BASE_URL=http://localhost:8000
CAMPUS_SECURITY_PHONE=       # optional: receives SOS SMS (SMS gateway is paid; console-only for now)
CAMPUS_SECURITY_EMAIL=    # optional, free: receives SOS alerts by email (uses the SMTP settings above)

# ---- Night-time pickup rule (free) ----
# Between NIGHT_START_HOUR and NIGHT_END_HOUR (Pakistan time) pickups must be within GATE_RADIUS_M of a gate.
# Get coordinates: right-click the gate in Google Maps and click the numbers to copy them.
# Format: Name:lat,lng;Name:lat,lng     Empty = rule switched off.
CAMPUS_GATES=Main Gate:24.9300,67.1140
GATE_RADIUS_M=150
NIGHT_START_HOUR=20
NIGHT_END_HOUR=6
CAMPUS_UTC_OFFSET_HOURS=5

MAPS_PROVIDER=mapbox 
MAPBOX_TOKEN=